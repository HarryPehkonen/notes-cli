#!/usr/bin/env python3
"""notes — the CLI for a Notes server (harrisnotes.ca-compatible).

Stdlib only: no dependencies, no build step. One executable file.

The API token is never passed on a command line, never printed, and never included
in an error message. Where it comes from, highest priority first:
    1. HN_AUTH_FILE            explicit path to an auth file
    2. NOTES_TOKEN             (+ NOTES_BASE_URL, default https://harrisnotes.ca/api)
    3. --profile NAME          ~/.config/notes-cli/auth.NAME.json
    4. ~/.config/notes-cli/auth.json
    5. ~/.config/hn/auth.json  (legacy fallback)
Auth files must be mode 600. `notes setup` writes one.

Read paths are the read endpoints:
    GET /api/notes?limit=N        -> data.notes[]        (pinned first)
    GET /api/notes/:id            -> data              (one note)
    GET /api/tags                 -> data[]            (bare list)
    GET /api/tags/:id/notes       -> data[]            (notes carrying a tag)
    GET /api/search?q=            -> data.results[]    (ranked)
Every response is wrapped: {"success": bool, "data": ..., "meta"?: ...}.

What `--json` prints is the *unwrapped* `data` of that envelope, never the envelope
itself: the note object (with a top-level "id") for show/create/set/append/prepend/
restore, a bare array for list/search/tags/versions, whatever the endpoint returns for
tag/untag/archive. `--json-envelope` prints the server's literal response instead — the
API's own shape, and the only way to reach meta.total / meta.hasMore, because
GET /notes is a page. See the README section "JSON output".
"""

import argparse
import getpass
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

PROG = "notes"
DEFAULT_BASE_URL = "https://harrisnotes.ca/api"
TIMEOUT = 20
PROFILE_RE = re.compile(r"[A-Za-z0-9][A-Za-z0-9_.-]*\Z")


class HnError(Exception):
    """Anything worth showing the user instead of a traceback.

    Carries the HTTP status when there is one, so callers can react to a specific
    code — 409 Conflict on a write is the case that matters.
    """

    def __init__(self, message, status=None):
        super().__init__(message)
        self.status = status


def config_dir():
    return Path.home() / ".config" / "notes-cli"


def legacy_auth_path():
    return Path.home() / ".config" / "hn" / "auth.json"


def check_profile(profile):
    if not PROFILE_RE.match(profile):
        raise HnError(f"bad profile name {profile!r} — use letters, digits, '_', '-', '.'")
    return profile


def profile_path(profile=None):
    return config_dir() / (f"auth.{check_profile(profile)}.json" if profile else "auth.json")


def check_base_url(base, where):
    base = (base or "").rstrip("/")
    if not base.startswith(("http://", "https://")):
        raise HnError(f"{where}: base_url must be an http(s) URL")
    return base


def load_auth(path=None, profile=None):
    """Return (base_url, token); see the module docstring for the precedence."""
    path = path or os.environ.get("HN_AUTH_FILE")
    if not path and os.environ.get("NOTES_TOKEN"):
        base = os.environ.get("NOTES_BASE_URL") or DEFAULT_BASE_URL
        return check_base_url(base, "NOTES_BASE_URL"), os.environ["NOTES_TOKEN"]
    if not path:
        if profile:
            path = profile_path(profile)
        else:
            path = profile_path()
            if not path.exists() and legacy_auth_path().exists():
                path = legacy_auth_path()
    p = Path(path)
    if not p.exists():
        raise HnError(
            f"no auth file at {p}\n"
            "Run `notes setup" + (f" --profile {profile}" if profile else "") + "` "
            "(the token is prompted for, so it never reaches the shell history),\n"
            "or set NOTES_TOKEN."
        )
    mode = p.stat().st_mode & 0o777
    if mode & 0o077:
        raise HnError(f"{p} is mode {oct(mode)} and holds a token — chmod 600 it")
    try:
        d = json.loads(p.read_text())
    except (OSError, ValueError) as e:
        raise HnError(f"cannot read {p}: {e}")
    for key in ("base_url", "token"):
        if not d.get(key):
            raise HnError(f"{p} has no {key!r} — re-run `notes setup`")
    return check_base_url(d["base_url"], str(p)), d["token"]


class Client:
    """HTTP seam. Tests replace .request() (or the whole client), never the network.

    `request()` hands back the unwrapped `data`; `request_full()` hands back the whole
    response. The whole response is also kept in `.last_payload` — that is what
    `--json-envelope` prints, and every command prints the response of the request it
    acts on, which is always the last one it makes (a lookup for an id or a tag name
    comes first, the write or the note read comes last).
    """

    def __init__(self, base_url, token, timeout=TIMEOUT):
        self.base_url = base_url
        self.token = token
        self.timeout = timeout
        self.last_payload = None      # the literal body of the last response

    def request(self, method, path, params=None, body=None):
        payload = self.request_full(method, path, params=params, body=body)
        return payload.get("data") if isinstance(payload, dict) else None

    def request_full(self, method, path, params=None, body=None):
        """The server's literal payload: {"success": ..., "data": ..., "meta": ...}.

        None for a response with no body (204 on archive, for instance), which is the
        truthful answer here: --json-envelope prints `null` for it.
        """
        url = f"{self.base_url}{path}"
        if params:
            url += "?" + urllib.parse.urlencode(params)
        data = json.dumps(body).encode("utf-8") if body is not None else None
        req = urllib.request.Request(url, data=data, method=method)
        req.add_header("Authorization", f"Bearer {self.token}")
        req.add_header("Accept", "application/json")
        if data is not None:
            req.add_header("Content-Type", "application/json")
        try:
            with urllib.request.urlopen(req, timeout=self.timeout) as resp:
                raw = resp.read().decode("utf-8", "replace")
        except urllib.error.HTTPError as e:
            raw = e.read().decode("utf-8", "replace")
            raise HnError(self._explain(e.code, raw), status=e.code) from None
        except urllib.error.URLError as e:
            raise HnError(f"cannot reach {self.base_url}: {e.reason}") from None
        if not raw.strip():
            self.last_payload = None
            return None
        try:
            payload = json.loads(raw)
        except ValueError:
            raise HnError(f"server sent non-JSON: {raw[:200]}") from None
        if not payload.get("success", False):
            raise HnError(payload.get("error") or f"request failed: {raw[:200]}")
        self.last_payload = payload
        return payload

    @staticmethod
    def _explain(code, raw):
        try:
            msg = json.loads(raw).get("error")
        except ValueError:
            msg = raw.strip()[:200]
        return f"HTTP {code}: {msg or 'request failed'}"

    def get(self, path, params=None):
        return self.request("GET", path, params=params)


# ---------------------------------------------------------------- formatting

def tag_names(note):
    tags = note.get("tags") or []
    return [t.get("name") if isinstance(t, dict) else str(t) for t in tags]


def one_line(note):
    tags = tag_names(note)
    suffix = "  [" + " ".join(tags) + "]" if tags else ""
    pin = "*" if note.get("is_pinned") else " "
    return f"{pin}{note.get('id'):>4}  {note.get('title') or '(untitled)'}{suffix}"


def show_note(note, raw=False):
    """One note for a human: --raw is the content alone, else a short header block."""
    content = note.get("content") or ""
    if raw:
        sys.stdout.write(content if content.endswith("\n") else content + "\n")
        return
    tags = tag_names(note)
    head = f"#{note.get('id')}  {note.get('title') or '(untitled)'}"
    if tags:
        head += "  [" + " ".join(tags) + "]"
    print(head)
    when = note.get("updated_at") or "?"
    print(f"updated {when}" + ("   pinned" if note.get("is_pinned") else ""))
    print("-" * 72)
    print(content)


def notes_of(client, limit=None):
    data = client.get("/notes", {"limit": limit} if limit else None)
    if isinstance(data, dict):
        return data.get("notes") or []
    return data or []


def all_tags(client):
    tags = client.get("/tags") or []
    if isinstance(tags, dict):
        tags = tags.get("tags") or []
    return tags


def find_tag_id(client, name):
    for t in all_tags(client):
        if (t.get("name") or "").lower() == name.lower():
            return t["id"]
    raise HnError(f"no tag named {name!r} (see `notes tags`)")


def resolve(client, which):
    """An id, or a case-insensitive substring of one title."""
    if which.isdigit():
        return client.get(f"/notes/{int(which)}")
    hits = [n for n in notes_of(client) if which.lower() in (n.get("title") or "").lower()]
    if not hits:
        raise HnError(f"no note matches {which!r}")
    if len(hits) > 1:
        listing = "\n".join("  " + one_line(n) for n in hits[:12])
        raise HnError(f"{len(hits)} notes match {which!r} — use an id:\n{listing}")
    return client.get(f"/notes/{hits[0]['id']}")


# ------------------------------------------------------------------ commands

def cmd_list(client, args):
    if args.tag:
        data = client.get(f"/tags/{find_tag_id(client, args.tag)}/notes") or []
        notes = data if isinstance(data, list) else (data.get("notes") or [])
    else:
        notes = notes_of(client, args.limit)
    if args.json:
        emit_json(client, notes, args.json)
        return 0
    if not notes:
        print("no notes")
        return 0
    for n in notes:
        print(one_line(n))
    print(f"\n{len(notes)} note(s)" + (f", tag {args.tag!r}" if args.tag else ""))
    return 0


def cmd_show(client, args):
    which = pick_or_explain(client, args, "note> ", "show")
    if which is None:
        return 1
    note = resolve(client, which)
    if args.json:
        emit_json(client, note, args.json)
        return 0
    show_note(note, raw=args.raw)
    return 0


def cmd_search(client, args):
    data = client.get("/search", {"q": args.query}) or {}
    results = (data.get("results") if isinstance(data, dict) else data) or []
    if args.json:
        emit_json(client, results, args.json)
        return 0
    if not results:
        print(f"nothing found for {args.query!r}")
        return 0
    for n in results:
        print(one_line(n))
    print(f"\n{len(results)} result(s) for {args.query!r}")
    return 0


def cmd_tags(client, args):
    tags = all_tags(client)
    if args.json:
        emit_json(client, tags, args.json)
        return 0
    if not tags:
        print("no tags")
        return 0
    width = max(len(t.get("name") or "?") for t in tags) + 2
    for t in sorted(tags, key=lambda x: (-(x.get("note_count") or 0), x.get("name") or "")):
        print(f"{(t.get('name') or '?'):<{width}} {t.get('note_count') or 0:>3} note(s)")
    print(f"\n{len(tags)} tag(s)")
    return 0


# -------------------------------------------------------------------- picking
#
# fzf is a convenience, never a dependency: if it is missing, or there is no
# terminal to draw in, hn prints the list and says how to get the picker. Nothing
# about hn requires it, so a machine without fzf keeps working exactly as before.

PICK_HINT = """fzf is not installed (or there is no terminal here), so notes cannot pick
interactively. Install fzf for the picker, or name a note directly:

    notes {cmd} <id or part of a title>

Notes you could have picked:"""


def fzf_path():
    """The fzf to use: $HN_FZF if set, otherwise whatever is on $PATH."""
    return os.environ.get("HN_FZF") or shutil.which("fzf")


def can_pick():
    """Picking needs a picker and a terminal. Overridden in tests."""
    return bool(fzf_path()) and sys.stdin.isatty() and sys.stdout.isatty()


def choose(notes, prompt):
    """Ask for one note. Returns an id, or None if cancelled or cannot pick.

    Lines are fed as '<id>\t<label>' so the id can be read back unambiguously while
    fzf displays only the label.
    """
    if not can_pick():
        return None
    lines = "".join(f"{n.get('id')}\t{one_line(n)}\n" for n in notes)
    cmd = [fzf_path(), "--delimiter=\t", "--with-nth=2..", f"--prompt={prompt}"]
    proc = subprocess.run(cmd, input=lines, text=True, capture_output=True)
    if proc.returncode != 0 or not proc.stdout.strip():
        return None            # Esc / Ctrl-C / no match: nothing chosen, nothing done
    return int(proc.stdout.split("\t", 1)[0])


def pick_or_explain(client, args, prompt, cmd_name):
    """Resolve args.which, picking interactively when it was not given.

    Returns the note id as a string, or None after explaining itself.
    """
    if args.which:
        return args.which
    notes = notes_of(client, 50)
    if args.no_pick:
        for n in notes:
            print(one_line(n))
        return None
    if notes:
        chosen = choose(notes, prompt)
        if chosen is not None:
            return str(chosen)
    print(PICK_HINT.format(cmd=cmd_name), file=sys.stderr)
    for n in notes:
        print(one_line(n))
    return None


# -------------------------------------------------------------------- editing
#
# The rule for everything below: the user's text is never at risk. A conflict, a
# crashed editor or a changed note must leave the edited text on disk and must not
# write anything to the server. The lock is the note's updated_at: the server
# answers 409 when it has moved, and hn checks the same thing itself first, because
# a client that sends the wrong field name is silently unprotected (measured:
# updated_at is the one the server honours; updatedAt/contentVersion are ignored).

EDITOR_FALLBACK = "vi"


def editor_command(override=None):
    """--editor, then $HN_EDITOR, $VISUAL, $EDITOR, then vi. May contain arguments."""
    for candidate in (override, os.environ.get("HN_EDITOR"), os.environ.get("VISUAL"),
                      os.environ.get("EDITOR"), EDITOR_FALLBACK):
        if candidate:
            return shlex.split(candidate)
    return [EDITOR_FALLBACK]


def temp_note_file(note_id, content):
    """A private directory holding the note body: dir 700, file 600."""
    d = Path(tempfile.mkdtemp(prefix=f"hn-edit-{note_id}-"))
    os.chmod(d, 0o700)
    p = d / f"note-{note_id}.md"
    p.write_text(content)
    os.chmod(p, 0o600)
    return p


def conflict_message(note_id, fresh, keep):
    lines = [f"note {note_id} changed on the server since you started — NOTHING was written."]
    server_len = len(fresh.get("content") or "")
    lines.append(f"  server now: {fresh.get('updated_at')}  ({server_len} bytes)")
    if keep is not None:
        lines.append(f"  your edits: {keep}  ({keep.stat().st_size} bytes — kept)")
        lines.append(f"  re-run:     notes edit {note_id} --content-file {keep}")
        lines.append("  or open both and merge by hand.")
    return "\n".join(lines)


def cmd_edit(client, args):
    which = pick_or_explain(client, args, "edit> ", "edit")
    if which is None:
        return 1
    note = resolve(client, which)
    note_id = note.get("id")
    started_from = note.get("updated_at")
    original = note.get("content") or ""

    path = None
    if args.content_file:
        edited = Path(args.content_file).read_text()
    else:
        path = temp_note_file(note_id, original)
        cmd = editor_command(args.editor) + [str(path)]
        if not args.quiet:
            print(f"editing note {note_id} with '{cmd[0]}' (temp file {path})", file=sys.stderr)
        rc = subprocess.call(cmd)
        if rc != 0:
            raise HnError(f"the editor exited {rc} — nothing was written;\n"
                          f"  your text is still at {path}")
        if not path.exists():
            shutil.rmtree(path.parent, ignore_errors=True)
            raise HnError(f"the editor removed {path.parent} — nothing was written")
        edited = path.read_text()

    def tidy():
        if path is not None:
            shutil.rmtree(path.parent, ignore_errors=True)

    if edited == original:
        print(f"note {note_id} unchanged — nothing sent to the server")
        tidy()
        return 0

    body = {"content": edited, "updated_at": started_from}
    if args.dry_run:
        print(f"would PUT /notes/{note_id} with {len(edited)} bytes (was {len(original)}), "
              f"lock updated_at={started_from}")
        print(f"  first 80 chars: {edited[:80]!r}")
        tidy()
        return 0

    fresh = client.get(f"/notes/{note_id}")
    if fresh.get("updated_at") != started_from:
        raise HnError(conflict_message(note_id, fresh, path))

    try:
        result = client.request("PUT", f"/notes/{note_id}", body=body)
    except HnError as e:
        if e.status == 409:
            raise HnError(conflict_message(note_id, client.get(f"/notes/{note_id}"), path)) from None
        raise

    now = (result or {}).get("updated_at") if isinstance(result, dict) else None
    print(f"note {note_id} updated: {len(original)} -> {len(edited)} bytes"
          + (f", version now {now}" if now else ""))
    tidy()
    return 0


# --------------------------------------------------------------------- writing
#
# Every write goes through client.request(), the same seam the reads use. Updates
# send title+content only (never tags): tags have their own endpoints, and a PUT that
# carried a stale tag list could undo a concurrent tag change.

def read_body(path):
    """The text of --body-file; '-' means stdin."""
    if path == "-":
        return sys.stdin.read()
    try:
        return Path(path).read_text()
    except OSError as e:
        raise HnError(f"cannot read {path}: {e.strerror or e}")


def with_newline(text):
    return text if not text or text.endswith("\n") else text + "\n"


def emit_json(client, value, mode="data"):
    """The --json printer, both shapes in one place.

    `value` is the unwrapped payload the command computed — the default shape, the one
    `jq .id` / `jq '.[0].id'` expect. mode "envelope" (--json-envelope) prints what the
    server actually said instead: the whole {"success", "data", "meta"} response.
    """
    print(json.dumps(client.last_payload if mode == "envelope" else value,
                     indent=2, ensure_ascii=False))


def current_note(client, note_id):
    note = client.get(f"/notes/{note_id}")
    return note, note.get("title") or "", note.get("content") or ""


def put_note(client, note_id, title, content):
    return client.request("PUT", f"/notes/{note_id}", body={"title": title, "content": content})


def cmd_create(client, args):
    content = read_body(args.body_file)
    if args.task:
        content = with_newline(content) + "".join(f"- [ ] {t}\n" for t in args.task)
    tag_ids = [find_tag_id(client, name) for name in args.tag or []]
    note = client.request("POST", "/notes",
                          body={"title": args.title, "content": content, "tags": tag_ids})
    if args.json:
        emit_json(client, note, args.json)
    else:
        print(f"created note {(note or {}).get('id')}: {args.title}")
    return 0


def _join(client, args, prepend):
    body = read_body(args.body_file)
    _, title, content = current_note(client, args.id)
    new = with_newline(body) + content if prepend else with_newline(content) + body
    result = put_note(client, args.id, title, new)
    if args.json:
        emit_json(client, result, args.json)
    else:
        print(f"note {args.id} {'prepended' if prepend else 'appended'}: "
              f"{len(content)} -> {len(new)} bytes")
    return 0


def cmd_append(client, args):
    return _join(client, args, prepend=False)


def cmd_prepend(client, args):
    return _join(client, args, prepend=True)


def cmd_set(client, args):
    if args.title is None and args.body_file is None:
        raise HnError("nothing to set: give --title and/or --body-file")
    _, title, content = current_note(client, args.id)
    if args.title is not None:
        title = args.title
    if args.body_file is not None:
        content = read_body(args.body_file)
    result = put_note(client, args.id, title, content)
    if args.json:
        emit_json(client, result, args.json)
    else:
        print(f"note {args.id} updated")
    return 0


def _tagging(client, args, adding):
    tag_id = find_tag_id(client, args.name)
    path = f"/notes/{args.id}/tags/{tag_id}"
    result = client.request("PUT" if adding else "DELETE", path)
    if args.json:
        emit_json(client, result, args.json)
    else:
        print(f"note {args.id}: {'tagged' if adding else 'untagged'} {args.name}")
    return 0


def cmd_tag(client, args):
    return _tagging(client, args, True)


def cmd_untag(client, args):
    return _tagging(client, args, False)


def cmd_archive(client, args):
    result = client.request("DELETE", f"/notes/{args.id}")
    if args.json:
        emit_json(client, result, args.json)
    else:
        print(f"note {args.id} archived (soft delete; still readable by id)")
    return 0


def versions_of(client, note_id):
    data = client.get(f"/notes/{note_id}/versions") or []
    if isinstance(data, dict):
        data = data.get("versions") or []
    return data


def cmd_versions(client, args):
    versions = versions_of(client, args.id)
    if args.json:
        emit_json(client, versions, args.json)
        return 0
    if not versions:
        print(f"note {args.id} has no saved versions")
        return 0
    for v in versions:
        vid = v.get("version_id", v.get("id"))
        print(f"{vid!s:>6}  {v.get('created_at') or '?'}  {v.get('title') or ''}  "
              f"({len(v.get('content') or '')} bytes)")
    print(f"\n{len(versions)} version(s)")
    return 0


def cmd_restore(client, args):
    versions = versions_of(client, args.id)
    if not versions:
        raise HnError(f"note {args.id} has no saved versions")
    match = [v for v in versions if str(v.get("id")) == str(args.version_id)]
    if not match:
        raise HnError(f"note {args.id} has no version {args.version_id} (see `notes versions {args.id}`)")
    v = match[0]
    title = v.get("title")
    if not title:
        _, title, _ = current_note(client, args.id)
    result = put_note(client, args.id, title, v.get("content") or "")
    if args.json:
        emit_json(client, result, args.json)
    else:
        print(f"note {args.id} restored from version {args.version_id}")
    return 0


# ----------------------------------------------------------------------- setup

def cmd_setup(args, ask=input, ask_secret=getpass.getpass):
    """Prompt for base URL and token; write the auth file (file 600, dir 700)."""
    profile = getattr(args, "profile", None)
    target = profile_path(profile)
    base = ask(f"Notes API base URL [{DEFAULT_BASE_URL}]: ").strip() or DEFAULT_BASE_URL
    base = check_base_url(base, "base URL")
    token = ask_secret("API token (input hidden): ").strip()
    if not token:
        raise HnError("no token given — nothing written")
    target.parent.mkdir(parents=True, exist_ok=True)
    os.chmod(target.parent, 0o700)
    fd = os.open(target, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(json.dumps({"base_url": base, "token": token}, indent=2) + "\n")
    os.chmod(target, 0o600)
    print(f"wrote {target} (mode 600) for {base}")
    return 0


# ---------------------------------------------------------------------- main

def add_json_flags(parser):
    """`--json` and `--json-envelope`, written once for every command that prints JSON.

    Both write the same dest, so the last one on the command line wins and
    --json-envelope means JSON output without any extra logic. The shapes themselves
    are documented in README, "JSON output".
    """
    parser.add_argument("--json", dest="json", action="store_const", const="data", default=None,
                        help="the data payload as JSON — the note object (id at the top "
                             "level), or a bare array; see README, 'JSON output'")
    parser.add_argument("--json-envelope", dest="json", action="store_const", const="envelope",
                        help="the server's whole {success, data, meta} response (implies "
                             "--json); the only way to see meta.total / meta.hasMore")


def build_parser():
    p = argparse.ArgumentParser(prog=PROG, description="the CLI for a Notes server")
    p.add_argument("--profile", metavar="NAME",
                   help="use ~/.config/notes-cli/auth.NAME.json (for several servers)")
    sub = p.add_subparsers(dest="command", required=True)

    lp = sub.add_parser("list", aliases=["ls"], help="list notes (pinned first)")
    lp.add_argument("--tag", help="only notes carrying this tag")
    lp.add_argument("--limit", type=int, default=20, help="how many to fetch (default 20)")
    add_json_flags(lp)
    lp.set_defaults(func=cmd_list)

    sp = sub.add_parser("show", aliases=["get"], help="show one note; with no argument, pick one")
    sp.add_argument("which", nargs="?",
                    help="an id, or part of a title (omit to pick with fzf)")
    sp.add_argument("--raw", action="store_true",
                    help="content only, for `notes show 92 --raw | vim -` or `| less`")
    add_json_flags(sp)
    sp.add_argument("--no-pick", action="store_true",
                    help="never open the picker: just list what is available")
    sp.set_defaults(func=cmd_show)

    qp = sub.add_parser("search", help="full-text search")
    qp.add_argument("query")
    add_json_flags(qp)
    qp.set_defaults(func=cmd_search)

    ep = sub.add_parser("edit", help="edit a note's content in $EDITOR (never clobbers)")
    ep.add_argument("which", nargs="?",
                    help="an id, or a unique part of the title (omit to pick with fzf)")
    ep.add_argument("--editor", help="editor to run (default $HN_EDITOR, $VISUAL, $EDITOR, vi)")
    ep.add_argument("--content-file", help="take the new content from this file (no editor)")
    ep.add_argument("--dry-run", action="store_true", help="say what would be sent, send nothing")
    ep.add_argument("--no-pick", action="store_true",
                    help="never open the picker: just list what is available")
    ep.add_argument("-q", "--quiet", action="store_true", help="no progress line on stderr")
    ep.set_defaults(func=cmd_edit)

    tp = sub.add_parser("tags", help="list tags with note counts")
    add_json_flags(tp)
    tp.set_defaults(func=cmd_tags)

    def target(name, help_, with_body=False, body_required=False, with_name=False, json_flag=True):
        sp_ = sub.add_parser(name, help=help_)
        if name != "create":
            sp_.add_argument("id", type=int, help="note id")
        if with_name:
            sp_.add_argument("name", help="tag name")
        if with_body:
            sp_.add_argument("--body-file", required=body_required,
                             help="file to read the text from ('-' for stdin)")
        if json_flag:
            add_json_flags(sp_)
        return sp_

    cp = target("create", "create a note", with_body=True, body_required=True)
    cp.add_argument("--title", required=True)
    cp.add_argument("--tag", action="append", help="tag name (repeatable)")
    cp.add_argument("--task", action="append",
                    help="add a '- [ ] item' line to the content (repeatable)")
    cp.set_defaults(func=cmd_create)
    target("append", "append text to a note", with_body=True, body_required=True
           ).set_defaults(func=cmd_append)
    target("prepend", "prepend text to a note", with_body=True, body_required=True
           ).set_defaults(func=cmd_prepend)
    stp = target("set", "replace a note's title and/or content", with_body=True)
    stp.add_argument("--title")
    stp.set_defaults(func=cmd_set)
    target("tag", "add a tag to a note", with_name=True).set_defaults(func=cmd_tag)
    target("untag", "remove a tag from a note", with_name=True).set_defaults(func=cmd_untag)
    target("archive", "archive (soft-delete) a note").set_defaults(func=cmd_archive)
    target("versions", "list a note's saved versions").set_defaults(func=cmd_versions)
    rp = target("restore", "restore a note's content from a saved version")
    rp.add_argument("version_id")
    rp.set_defaults(func=cmd_restore)

    setp = sub.add_parser("setup", help="store the server URL and token (prompts; token hidden)")
    setp.add_argument("--profile", metavar="NAME", default=argparse.SUPPRESS)
    setp.set_defaults(func=None)

    sub.add_parser("version", help="print the version").set_defaults(
        func=lambda client, args: (print(f"{PROG} {VERSION}"), 0)[1])
    return p


VERSION = "1.1.0"


def main(argv=None):
    args = build_parser().parse_args(argv)
    try:
        if args.command == "setup":
            return cmd_setup(args)
        base_url, token = load_auth(profile=args.profile)
        return args.func(Client(base_url, token), args)
    except HnError as e:
        print(f"{PROG}: {e}", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main())
